{
	"name": "@svelbase/sv",
	"description": "sv add-on for @svelbase/sv",
	"version": "0.0.1",
	"type": "module",
	"license": "GPL-3.0-only",
	"scripts": {
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"demo-add:ci": "pnpm build && sv add file:../=who:you --cwd demo --no-git-check --no-download-check --no-install",
		"build": "tsdown",
		"dev": "tsdown src/index.ts --format esm --watch",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"sv": "^0.17.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/sv-utils": "^0.3.3",
		"@types/node": "^25.9.1",
		"adm-zip": "^0.6.0",
		"pocketbase": "^0.28.0",
		"sv": "^0.17.0",
		"tsdown": "^0.22.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.8"
	},
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit",
		"pocketbase",
		"auth"
	]
}
